# Copy this file to `.env` and fill in the values from the Discord Developer Portal
# https://discord.com/developers/applications

# Bot token (Application -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application (client) ID (Application -> General Information -> Application ID)
CLIENT_ID=

# Optional: a test server ID. If set, `npm run deploy` registers commands to this
# guild only (instant updates). Leave empty to register commands globally (can
# take up to 1 hour to propagate).
GUILD_ID=
